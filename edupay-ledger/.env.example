# =============================================================================
# eBursar Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Configuration (REQUIRED for cloud features)
# Get these from Firebase Console > Project Settings > Your Apps
# In development, fallback values are used if not set.
# In PRODUCTION, these MUST be configured.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# -----------------------------------------------------------------------------
# Sentry Error Reporting (RECOMMENDED for production)
# Get these from Sentry.io > Project Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=ebursar
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_MODE=web
NEXT_PUBLIC_SYNC_ENABLED=true

# -----------------------------------------------------------------------------
# Stellar Blockchain Integration
# eBursar uses Stellar to anchor payment proofs as an immutable audit trail.
# This does NOT move money - only stores cryptographic proof hashes.
# -----------------------------------------------------------------------------
# Network: TESTNET (default) or PUBLIC (mainnet)
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Anchor account public key (for transaction verification)
# Generate new keypair at: https://laboratory.stellar.org/#account-creator
NEXT_PUBLIC_STELLAR_ANCHOR_PUBLIC_KEY=

# Anchor account secret key (KEEP THIS SECURE - server-side only)
# WARNING: Never expose this in client-side code or commit to version control
STELLAR_ANCHOR_SECRET_KEY=

# Horizon API endpoint (optional - uses default for network if not set)
# TESTNET: https://horizon-testnet.stellar.org
# PUBLIC: https://horizon.stellar.org
# STELLAR_HORIZON_URL=

# Fund testnet account at: https://friendbot.stellar.org?addr=YOUR_PUBLIC_KEY

# -----------------------------------------------------------------------------
# Optional: SMS Integration (Africa's Talking)
# -----------------------------------------------------------------------------
# AFRICASTALKING_API_KEY=your_api_key
# AFRICASTALKING_USERNAME=your_username
# AFRICASTALKING_SENDER_ID=eBursar

# -----------------------------------------------------------------------------
# Development Options
# -----------------------------------------------------------------------------
# Use Firebase Emulators (set to 'true' to use local emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
